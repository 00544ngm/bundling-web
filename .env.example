# Legacy provider bootstrap (optional)
# On web-backend startup these values are imported only when the matching
# provider has no saved database configuration. Manage later changes at
# http://localhost:3000/settings/api.

# GPT API
OPENAI_API_KEY=sk-your-key-here

# 可用模型（切换时取消注释对应的行）：
# gpt-5.6-terra  gpt-5.6-sol  gpt-5.6-luna  gpt-5.6
# gpt-5.5  gpt-5.5-pro  gpt-4o
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=16384
OPENAI_TEMPERATURE=0.3

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Browser
HEADLESS=false
BROWSER_WS_ENDPOINT=
# 可选：显式指定 Chrome 可执行文件路径（不填则按系统自动查找；Linux 通常为 /usr/bin/google-chrome）
# CHROME_EXECUTABLE_PATH=
CAPTCHA_WAIT_ENABLED=true
CAPTCHA_WAIT_TIMEOUT_SECONDS=600
CAPTCHA_CHECK_INTERVAL_SECONDS=5

# Timeout & retry
TIMEOUT_MS=30000
MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# 注意：这个文件只放 app.core.config.Settings 认识的键（上面那些）。
#
# Settings 的 pydantic 配置是 extra=forbid（pydantic-settings 的默认值），
# 只要这里出现一个它没声明的键，复制成 .env 后应用启动就会直接崩：
#
#   pydantic_core.ValidationError: 1 validation error for Settings
#     provider_key_file  Extra inputs are not permitted [type=extra_forbidden]
#
# DATABASE_URL / REDIS_URL / CORS_ORIGINS / ALLOW_REMOTE_SETTINGS /
# AUTH_* / PROVIDER_ENCRYPTION_KEY / PROVIDER_KEY_FILE 这些**属于后端**，
# 要放 backend/.env（那边由 BackendSettings 读，它 extra=ignore）。
# ─────────────────────────────────────────────────────────────────────────────
