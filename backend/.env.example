DATABASE_URL=postgresql+asyncpg://bundling:bundling@127.0.0.1:5432/bundling
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=["http://localhost:3000"]
ARTIFACT_DIR=output/bundling
API_PREFIX=/api/v1

# --- 登录鉴权 ---------------------------------------------------------------
# 必填。未设置时所有登录接口都会返回 503 AUTH_NOT_CONFIGURED，无法登录。
# 生成一个：python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# 登录令牌有效期（秒）。默认 30 天。
AUTH_TOKEN_TTL_SECONDS=2592000

# 首次启动时创建 admin 账号所用的初始密码。
# 留空则随机生成，并只在后端启动日志里打印一次（该账号强制首次登录后改密）。
ADMIN_INITIAL_PASSWORD=

# --- 远程管理 ---------------------------------------------------------------
# 设为 true 时 /settings/providers 允许从非本机访问（远程管理服务器部署时需要）。
# 仍要求管理员登录；默认 false 保持「仅本机可改」的安全姿态。
ALLOW_REMOTE_SETTINGS=false

# --- Provider 凭据加密 ------------------------------------------------------
# 留空则自动生成 backend/.api-config.key，需与 PostgreSQL 数据一起备份。
PROVIDER_ENCRYPTION_KEY=
PROVIDER_KEY_FILE=backend/.api-config.key
